[Unit]
Description=PurePulse original restored public website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=matt
WorkingDirectory=/home/matt/PurePulse-Recovery/deploy/purepulse-original
ExecStart=/usr/bin/python3 -m http.server 3014 --bind 127.0.0.1 --directory /home/matt/PurePulse-Recovery/deploy/purepulse-original
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/matt/PurePulse-Recovery/deploy/purepulse-original

[Install]
WantedBy=multi-user.target
